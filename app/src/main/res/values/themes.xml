<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.KKTBookmark" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Translucent bottom sheet style for Share Receiver Activity -->
    <style name="Theme.KKTBookmark.Translucent" parent="Theme.KKTBookmark">
        <item name="android:windowBackground">@color/translucent_black</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
